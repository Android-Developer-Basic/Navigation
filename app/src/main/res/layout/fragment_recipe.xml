<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/recipe_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/top_bar_background_light">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/recipe_toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:menu="@menu/recipe_menu"
                app:navigationIcon="@drawable/arrow_back_24dp"
                app:title="@string/recipe_name_placeholder">

                <androidx.appcompat.widget.ActionMenuView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end">

                </androidx.appcompat.widget.ActionMenuView>

            </com.google.android.material.appbar.MaterialToolbar>

        </com.google.android.material.appbar.AppBarLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <ScrollView
        android:id="@+id/scroll_recipe_steps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/recipe_app_bar"
        app:layout_constraintVertical_bias="0.0"
        tools:layout_editor_absoluteX="10dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <ImageView
                android:id="@+id/img_recipe_image_big"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/default_image_bg_light"
                android:contentDescription="@string/Recipe_image_description"
                android:src="@drawable/category_xxx_width"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txt_recipe_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/recipe_recipe_padding_bottom"
                android:text="@string/recipe_name_placeholder"
                android:textSize="@dimen/recipe_recipe_name"
                app:layout_constraintTop_toBottomOf="@id/img_recipe_image_big" />

            <TextView
                android:id="@+id/txt_recipe_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="@string/recipe_description_placeholder"
                android:textSize="@dimen/recipe_recipe_description"
                app:layout_constraintTop_toBottomOf="@id/txt_recipe_name" />


            <TextView
                android:id="@+id/txt_recipe_steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recipe_recipe_steps_placeholder"
                android:textSize="@dimen/recipe_recipe_steps"
                app:layout_constraintTop_toBottomOf="@id/txt_recipe_description" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>